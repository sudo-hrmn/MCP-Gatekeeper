# MCP Trust Gateway Environment Configuration Template

# LLM Security Classifier API Key (Supports OpenAI, Grok, DeepSeek, or local Ollama)
LLM_API_KEY="your-llm-api-key-here"
LLM_API_URL="https://api.x.ai/v1/chat/completions" # or https://api.openai.com/v1/chat/completions
LLM_MODEL="grok-2-latest" # or gpt-4o-mini, deepseek-chat, etc.

# Control-Plane Admin Key
ADMIN_API_KEY="trust-gateway-admin-key-secret"

# Gateway Server Settings
GATEWAY_HOST="0.0.0.0"
GATEWAY_PORT="8000"
DATABASE_URL="sqlite+aiosqlite:///mcp_trust_gateway.db"

# Security Policy & Timeouts
FAIL_CLOSED=true
CLASSIFIER_TIMEOUT_SECONDS=3.0
CONFIRMATION_TIMEOUT_SECONDS=60
